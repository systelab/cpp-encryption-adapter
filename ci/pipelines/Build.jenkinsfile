def version = "0.0.0"
def packageNameInterface = "encryption-adapter-interface"
def packageNameTestUtilities = "encryption-adapter-test-utilities"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']


@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	agent
	{
		label 'lib-build'
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}
 				}
			}
		}

		stage('Build')
		{	
			steps
			{
				dir('EncryptionAdapterInterface')
				{
					bat script: "conan export-pkg ./conanfile.py --name=${packageNameInterface} --version=${version} --output-folder=${env.WORKSPACE}/.conan --profile:all ${env.WORKSPACE}/${profile}",
						label: "Exporting package ${packageNameInterface}/${version}"
				}
				dir('EncryptionAdapterTestUtilities')
				{
					script
					{
						archs.each
						{ arch ->
							configs.each
							{ config ->
								stage("Build ${config}|${arch}")
								{
									def buildFolder = "build-${config}-${arch}"
									bat script: "conan install . --version=${version} --output-folder ${buildFolder} --profile:all ${env.WORKSPACE}/${profile} --settings:host build_type=${config} --settings:host arch=${arch}", label: 'Installing dependencies'
									bat script: "conan build . --version=${version} --output-folder ${buildFolder} --profile:all ${env.WORKSPACE}/${profile} --settings:host build_type=${config} --settings:host arch=${arch}", label: 'Building'
									bat script: "conan export-pkg . --name=${packageNameTestUtilities} --version=${version} --output-folder ${buildFolder} --profile:all ${env.WORKSPACE}/${profile} --settings:host build_type=${config} --settings:host arch=${arch}", label: "Exporting package ${packageNameTestUtilities}/${version}"
								}
							}
						}
					}
				
				}
			}
		}
		
		stage('Test Packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							bat "conan test test_package/conanfile.py ${packageNameTestUtilities}/${version} --profile:all ${profile} --settings:host arch=${arch} --settings:host build_type=${config}"
						}
					}
				}
			}
		}
		
		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script:"conan upload ${packageNameInterface}/${version} --remote aid-conan-production-local --confirm --force", label: "Uploading ${packageNameInterface} package to Artifactory"
					bat script:"conan upload ${packageNameTestUtilities}/${version} --remote aid-conan-production-local --confirm --force", label: "Uploading ${packageNameTestUtilities} package to Artifactory"
				}
			}
		}
	}
	
	post
		{
			always
			{
				script
				{
					currentBuild.description = "${version}"
				}
				cleanupWorkspace()
			}
		}
}